  "resolution"
 ],
 "fields": [
  {
   "fieldname": "section_general",
   "fieldtype": "Section Break",
   "label": "General"
  },
  {
   "description": "Type of PQR (Petición, Queja, Reclamo, etc.)",
   "fieldname": "pqr_type",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "PQR Type",
   "options": "PQR Type",
   "reqd": 1
  },
  {
   "description": "Short subject for this PQR",
   "fieldname": "subject",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Subject",
   "reqd": 1
  },
  {
   "fieldname": "column_break_general",
   "fieldtype": "Column Break"
  },
  {
   "default": "New",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "New\nIn Review\nIn Process\nResolved\nClosed\nRejected",
   "reqd": 1
  },
  {
   "default": "Now",
   "fieldname": "received_at",
   "fieldtype": "Datetime",
   "in_list_view": 1,
   "label": "Received At",
   "reqd": 1
  },
  {
   "default": "portal",
   "description": "Where this PQR came from",
   "fieldname": "source",
   "fieldtype": "Select",
   "in_standard_filter": 1,
   "label": "Source",
   "options": "portal\napi\ninternal\nemail\nphone\nother"
  },
  {
   "collapsible": 1,
   "fieldname": "section_submitter",
   "fieldtype": "Section Break",
   "label": "Submitter"
  },
  {
   "description": "Associated user contact (optional - leave empty for anonymous)",
   "fieldname": "user_contact",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "User Contact",
   "options": "User contact"
  },
  {
   "default": "0",
   "description": "Mark as anonymous - submitter info will not be stored",
   "fieldname": "is_anonymous",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Is Anonymous"
  },
  {
   "fieldname": "column_break_submitter",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:!doc.is_anonymous",
   "description": "Submitter full name (auto-filled from User Contact if linked)",
   "fetch_from": "user_contact.full_name",
   "fetch_if_empty": 1,
   "fieldname": "submitter_name",
   "fieldtype": "Data",
   "label": "Submitter Name"
  },
  {
   "depends_on": "eval:!doc.is_anonymous",
   "description": "Submitter email (auto-filled from User Contact if linked)",
   "fetch_from": "user_contact.email",
   "fetch_if_empty": 1,
   "fieldname": "submitter_email",
   "fieldtype": "Data",
   "label": "Submitter Email",
   "options": "Email"
  },
  {
   "depends_on": "eval:!doc.is_anonymous",
   "description": "Submitter phone (auto-filled from User Contact if linked)",
   "fetch_from": "user_contact.phone_number",
   "fetch_if_empty": 1,
   "fieldname": "submitter_phone",
   "fieldtype": "Data",
   "label": "Submitter Phone"
  },
  {
   "fieldname": "section_content",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "description": "Detailed description of the PQR submitted by the citizen",
   "fieldname": "description",
   "fieldtype": "Long Text",
   "label": "Description",
   "reqd": 1
  },
  {
   "collapsible": 1,
   "fieldname": "section_management",
   "fieldtype": "Section Break",
   "label": "Internal Management"
  },
  {
   "description": "User responsible for handling this PQR",
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Assigned To",
   "options": "User"
  },
  {
   "fieldname": "column_break_management",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.status === 'Resolved' || doc.status === 'Closed'",
   "fieldname": "resolved_at",
   "fieldtype": "Datetime",
   "label": "Resolved At"
  },
  {
   "collapsible": 1,
   "depends_on": "eval:doc.status === 'Resolved' || doc.status === 'Closed' || doc.status === 'Rejected'",
   "fieldname": "section_resolution",
   "fieldtype": "Section Break",
   "label": "Resolution"
  },
  {
   "description": "Response to the citizen",
   "fieldname": "resolution",
   "fieldtype": "Text Editor",
   "label": "Resolution"
  }
 ],
